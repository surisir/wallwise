ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=10485760
WALL_CONFIDENCE_THRESHOLD=0.35
SEGMENTATION_MODEL=nvidia/segformer-b5-finetuned-ade-640-640
YOLO_MODEL=yolo11n.pt
ENABLE_OBJECT_DETECTION=true
IMAGE_PROVIDER=gemini
GEMINI_API_KEY=replace_with_your_server_side_google_ai_studio_key
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
CLOUDFLARE_ACCOUNT_ID=replace_with_your_cloudflare_account_id
CLOUDFLARE_AI_TOKEN=replace_with_your_workers_ai_api_token
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
FAL_KEY=replace_with_your_server_side_fal_key
FAL_QWEN_MODEL=fal-ai/qwen-image-edit-2511
FAL_DOWNLOAD_TIMEOUT_SECONDS=90
